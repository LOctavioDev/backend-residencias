# Puerto HTTP del servidor
PORT=11111

# Cadena de conexión a MongoDB
MONGO_URI=mongodb://usuario:password@localhost:27017/residencias?authSource=admin

# Secreto para firmar los JWT (usa un valor largo y aleatorio: openssl rand -hex 32)
JWT_SECRET=cambia-este-valor

# Client ID de Google OAuth (opcional; vacío desactiva el inicio de sesión con Google)
CLIENT_ID=
